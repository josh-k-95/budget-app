# Copy to .env and fill in. Never commit .env.

# --- Database (used by docker-compose.yml) ---
POSTGRES_USER=budget
POSTGRES_PASSWORD=change-me
POSTGRES_DB=budget
# Host port for Postgres, bound to 127.0.0.1 only (for running the backend outside Docker).
DB_PORT=5432
# Only needed when running the backend outside Docker (the app container builds its own).
DATABASE_URL=postgresql+psycopg://budget:change-me@localhost:5432/budget

# --- App ---
# Display name shown in the UI, page titles and API docs.
APP_NAME=Budget App
# Canonical external URL (scheme + host, no trailing slash). Used for the CSRF Origin check
# and to decide the cookie's Secure flag (set when this is https).
# Local dev with the Vite server: PUBLIC_URL=http://localhost:5173
PUBLIC_URL=http://localhost:8000
# Allow new registrations. The first user can always register.
ALLOW_SIGNUP=true
# Allow login over plain HTTP from non-localhost hosts. Keep false unless you know why.
ALLOW_INSECURE_HTTP=false
# Minimum password length.
MIN_PASSWORD_LENGTH=8

# --- Network ---
# Proxy IPs trusted for X-Forwarded-* headers (comma-separated). Set this to exactly your
# reverse proxy's IP: per-IP login rate limits depend on it. Avoid * unless nothing else can
# reach the app port.
FORWARDED_ALLOW_IPS=127.0.0.1
# Host interface and port the app is published on. Use 0.0.0.0 to expose on the LAN.
APP_BIND=127.0.0.1
APP_PORT=8000
